#!/usr/bin/env bash
# One-shot, root-run Discord canary wrapper for a single enrolled hypervisor.
# Install only through a dated, operator-approved node packet.
set -euo pipefail

node_id="${HV_CP_NODE_ID:-__HV_CP_NODE_ID__}"
node_placeholder="__HV_CP""_NODE_ID__"
if [[ "$node_id" == "$node_placeholder" ]]; then
  printf 'hv-cp Discord canary blocked: node identifier not installed\n' >&2
  exit 3
fi
helper="${HV_CP_DISCORD_HELPER:-/opt/shopgpt-sysadmin/tools/notify_ntfy.sh}"
log="${HV_CP_DISCORD_LOG:-/var/log/hv-cp-discord-canary.log}"

if [[ ! -x "$helper" ]]; then
  printf 'hv-cp Discord canary blocked: helper absent: %s\n' "$helper" >&2
  exit 3
fi

if [[ ! -s /etc/shopgpt-sysadmin/discord-webhook-url ]]; then
  printf 'hv-cp Discord canary blocked: local webhook absent\n' >&2
  exit 3
fi

host="$(hostname -s)"
observed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
title="${host} Discord canary"
message="canary.delivery node_id=${node_id} host=${host} observed_at_utc=${observed_at}"

exec timeout 20s env \
  ALERT_TRANSPORT=discord \
  ALERT_FALLBACK_NTFY=0 \
  ALERT_LOG="$log" \
  "$helper" "$title" "$message"
